<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="20.11.1.0">
<procedure name="main">
<interface/>
<body>
<c>* 批量转换并保存所有图片</c>
<l>ImagePath := 'D:/00现场更新/610C/点位'</l>
<l>OutputPath := 'D:/00现场更新/610C/点位/测试'</l>
<c></c>
<c>* 创建输出目录（如果不存在）</c>
<l>file_exists (OutputPath, FileExists)</l>
<l>if (not FileExists)</l>
<l>    make_dir (OutputPath)</l>
<l>endif</l>
<c></c>
<c>* 获取所有图片文件</c>
<l>list_files (ImagePath, ['files','follow_links'], ImageFiles)</l>
<l>tuple_regexp_select (ImageFiles, ['\\.(png|jpg|jpeg|bmp|tiff|tif)$','ignore_case'], ImageFilesSelected)</l>
<c></c>
<l>if (|ImageFilesSelected| == 0)</l>
<l>    disp_message (3600, '未找到图片文件！', 'window', 100, 100, 'red', 'true')</l>
<l>    return ()</l>
<l>endif</l>
<c></c>
<c>* 设置Percent值 【灰度比】</c>
<l>Percent := 15</l>
<c></c>
<c>* 处理进度显示</c>
<l>dev_open_window (0, 0, 600, 300, 'black', WindowHandle)</l>
<l>dev_set_window (WindowHandle)</l>
<c></c>
<c>* 处理计数器</c>
<l>ProcessedCount := 0</l>
<c></c>
<c>* 循环处理每张图片</c>
<l>for Index := 0 to |ImageFilesSelected|-1 by 1</l>
<l>    try</l>
<c>        * 获取图片文件名</c>
<l>        tuple_split (ImageFilesSelected[Index], '\\', PathParts)</l>
<l>        OriginalName := PathParts[|PathParts|-1]</l>
<c>        </c>
<c>        * 显示处理进度</c>
<l>        dev_clear_window ()</l>
<l>        disp_message (WindowHandle, '正在处理第 ' + (Index+1)$'d' + '/' + |ImageFilesSelected|$'d' + ' 张图片', 'window', 50, 50, 'white', 'false')</l>
<l>        disp_message (WindowHandle, '文件名: ' + OriginalName, 'window', 80, 50, 'cyan', 'false')</l>
<c>        </c>
<c>        * 读取图片</c>
<l>        read_image (Image, ImageFilesSelected[Index])</l>
<c>        </c>
<c>        * 使用Percent=50进行处理</c>
<l>        min_max_gray (Image, Image, Percent, HeightMin, HeightMax, HeightRange)</l>
<l>        scale_image_range (Image, ImageScaled, HeightMin, HeightMax+1000)</l>
<l>        convert_image_type (ImageScaled, ImageByte, 'byte')</l>
<c>        </c>
<c>        * 生成输出文件名（在原文件名基础上添加后缀）</c>
<l>        tuple_split (OriginalName, '.', NameParts)</l>
<l>        BaseName := NameParts[0]</l>
<l>        if (|NameParts| &gt; 1)</l>
<l>            Extension := NameParts[|NameParts|-1]</l>
<l>        else</l>
<l>            Extension := 'png'</l>
<l>        endif</l>
<c>        </c>
<c>        * 构建输出文件完整路径</c>
<l>        OutputFileName := OutputPath + BaseName + '_p' + Percent$'d' + '.' + Extension</l>
<c>        </c>
<c>        * 保存图片</c>
<l>        write_image (ImageByte, Extension, 0, OutputFileName)</l>
<c>        </c>
<c>        * 显示保存信息</c>
<l>        disp_message (WindowHandle, '已保存: ' + BaseName + '_p' + Percent$'d' + '.' + Extension, 'window', 120, 50, 'green', 'false')</l>
<l>        disp_message (WindowHandle, '灰度范围: ' + HeightMin$'4.0f' + ' - ' + HeightMax$'4.0f', 'window', 150, 50, 'yellow', 'false')</l>
<c>        </c>
<l>        ProcessedCount := ProcessedCount + 1</l>
<c>        </c>
<c>        * 短暂延迟以便查看进度</c>
<l>        if (|ImageFilesSelected| &gt; 10)</l>
<l>            wait_seconds (0.1)  </l>
<l>        else</l>
<l>            wait_seconds (0.5)</l>
<l>        endif</l>
<c>        </c>
<l>    catch (Exception)</l>
<c>        * 记录错误但继续处理其他图片</c>
<l>        disp_message (WindowHandle, '处理失败: ' + OriginalName, 'window', 180, 50, 'red', 'false')</l>
<l>        disp_message (WindowHandle, '错误: ' + Exception, 'window', 210, 50, 'red', 'false')</l>
<l>        wait_seconds (1)</l>
<l>    endtry</l>
<l>endfor</l>
<c></c>
<c>* 处理完成</c>
<l>dev_clear_window ()</l>
<l>disp_message (WindowHandle, '批量转换完成！', 'window', 100, 100, 'green', 'true')</l>
<l>disp_message (WindowHandle, '成功处理: ' + ProcessedCount$'d' + ' 张', 'window', 130, 100, 'green', 'true')</l>
<l>disp_message (WindowHandle, '失败: ' + (|ImageFilesSelected| - ProcessedCount)$'d' + ' 张', 'window', 160, 100, 'yellow', 'true')</l>
<l>disp_message (WindowHandle, '输出目录: ' + OutputPath, 'window', 190, 100, 'cyan', 'true')</l>
<c></c>
<l>wait_seconds (3)</l>
</body>
<docu id="main">
<parameters/>
</docu>
</procedure>
</hdevelop>
