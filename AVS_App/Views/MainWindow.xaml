<Window
    x:Class="AVS_App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:AVS_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    Title="MainWindow"
    Width="800"
    Height="450"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#2D2D30">
            <StackPanel Margin="0,20,0,0">
                <TextBlock
                    Margin="0,0,0,30"
                    HorizontalAlignment="Center"
                    FontSize="20"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="AOI 导航菜单" />

                <Button
                    Height="40"
                    Margin="10,5"
                    Background="#3E3E42"
                    BorderThickness="0"
                    Command="{Binding NavigateCommand}"
                    CommandParameter="ParameterConfigView"
                    Content="⚙️ 参数配置"
                    FontSize="16"
                    Foreground="White" />

                <Button
                    Height="40"
                    Margin="10,5"
                    Background="#3E3E42"
                    BorderThickness="0"
                    Command="{Binding NavigateCommand}"
                    CommandParameter="CameraDebugView"
                    Content="📷 相机调试"
                    FontSize="16"
                    Foreground="White" />

                <Button
                    Height="40"
                    Margin="10,5"
                    Background="#3E3E42"
                    BorderThickness="0"
                    Command="{Binding NavigateCommand}"
                    CommandParameter="PlcDebugView"
                    Content=" 通讯测试"
                    FontSize="16"
                    Foreground="White" />

                <Button
                    Height="40"
                    Margin="10,5"
                    Background="#3E3E42"
                    BorderThickness="0"
                    Command="{Binding NavigateCommand}"
                    CommandParameter="HistoryRecordView"
                    Content="📊 历史记录"
                    FontSize="16"
                    Foreground="White" />
            </StackPanel>
        </Border>

        <ContentControl Grid.Column="1" prism:RegionManager.RegionName="MainContentRegion" />

        <GroupBox
            Grid.Column="2"
            BorderBrush="#555"
            Foreground="White"
            Header="系统日志">
            <DataGrid
                AutoGenerateColumns="False"
                Background="AliceBlue"
                BorderThickness="0"
                IsReadOnly="True"
                ItemsSource="{Binding LogSource}"
                RowHeaderWidth="0">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="80"
                        Binding="{Binding Timestamp}"
                        Header="时间" />
                    <DataGridTextColumn
                        Width="50"
                        Binding="{Binding Level}"
                        Header="级别">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{Binding Color}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding Message}"
                        Header="内容" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

    </Grid>
</Window>
