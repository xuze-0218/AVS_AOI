<Window
    x:Class="AVS_App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:AVS_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    Title="MainWindow"
    Width="800"
    Height="450"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#2D2D30">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  1. 顶部标题与状态灯  -->
                <StackPanel Grid.Row="0" Margin="0,20,0,10">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="AOI 视觉系统" />

                    <!--  PLC 状态指示  -->
                    <StackPanel
                        Margin="0,10"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                        <Ellipse
                            Width="10"
                            Height="10"
                            Margin="0,0,8,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="Red" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlcConnected}" Value="True">
                                            <Setter Property="Fill" Value="LimeGreen" />
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect
                                                        BlurRadius="8"
                                                        ShadowDepth="0"
                                                        Color="LimeGreen" />
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="#AAA"
                            Text="PLC 通讯状态" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <Button
                        Background="#007ACC"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="InspectionView"
                        Content="🔍 实时检测" />

                    <Button
                        Command="{Binding NavigateCommand}"
                        CommandParameter="ParameterConfigView"
                        Content="⚙️ 参数配置" />

                    <Button
                        Command="{Binding NavigateCommand}"
                        CommandParameter="CameraDebugView"
                        Content="📷 相机调试" />

                    <Button
                        Command="{Binding NavigateCommand}"
                        CommandParameter="PlcDebugView"
                        Content=" 通讯测试" />

                    <Button
                        Command="{Binding NavigateCommand}"
                        CommandParameter="HistoryRecordView"
                        Content="📊 历史记录" />
                </StackPanel>


            </Grid>
        </Border>

        <ContentControl Grid.Column="1" prism:RegionManager.RegionName="MainContentRegion" />

        <GroupBox
            Grid.Column="2"
            BorderBrush="#555"
            Foreground="White"
            Header="系统日志">
            <DataGrid
                AutoGenerateColumns="False"
                Background="AliceBlue"
                BorderThickness="0"
                IsReadOnly="True"
                ItemsSource="{Binding LogSource}"
                RowHeaderWidth="0">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="80"
                        Binding="{Binding Timestamp}"
                        Header="时间" />
                    <DataGridTextColumn
                        Width="50"
                        Binding="{Binding Level}"
                        Header="级别">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{Binding Color}" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding Message}"
                        Header="内容" />
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

    </Grid>
</Window>
