<Window
    x:Class="AVS_App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    Title="AOI 视觉系统"
    Width="1000"
    Height="600"
    MinWidth="900"
    MinHeight="500"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">

    <Window.Resources>
        <!--  导航按钮统一样式  -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Height" Value="42" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="24,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3A3A3E" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#505050" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  分隔线样式  -->
        <Style TargetType="Separator">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="#444" />
            <Setter Property="Margin" Value="16,6" />
        </Style>

        <!--  日志表格行样式  -->
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#252526" />
            <Setter Property="Foreground" Value="#D4D4D4" />
            <Setter Property="BorderBrush" Value="#333" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2E2E32" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#094771" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderBrush" Value="#333" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="0,0,0,1">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2D2D30" />
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderBrush" Value="#444" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="6,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#1E1E1E">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,24,0,12">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="#F5F5F5"
                        Text="AOI 视觉系统" />
                    <StackPanel
                        Margin="0,16,0,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                        <Ellipse
                            Width="12"
                            Height="12"
                            Margin="0,0,10,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#FF4C4C" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlcConnected}" Value="True">
                                            <Setter Property="Fill" Value="#4CAF50" />
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect
                                                        BlurRadius="8"
                                                        ShadowDepth="0"
                                                        Color="#4CAF50" />
                                                </Setter.Value>
                                            </Setter>
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="Fill.Color" Duration="0:0:0.4">
                                                            <DiscreteColorKeyFrame KeyTime="0:0:0" Value="#4CAF50" />
                                                        </ColorAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="Fill.Color" Duration="0:0:0.4">
                                                            <DiscreteColorKeyFrame KeyTime="0:0:0" Value="#FF4C4C" />
                                                        </ColorAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="#AAA"
                            Text="PLC 通讯" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,12,0,0">
                    <Button
                        Command="{Binding NavigateCommand}"
                        CommandParameter="InspectionView"
                        Content="🔍 实时检测"
                        Style="{StaticResource NavButtonStyle}" />
                    <Separator />
                    <Button
                        Command="{Binding NavigateCommand}"
                        CommandParameter="ParameterConfigView"
                        Content="⚙️ 参数配置"
                        Style="{StaticResource NavButtonStyle}" />
                    <Separator />
                    <Button
                        Command="{Binding NavigateCommand}"
                        CommandParameter="CameraDebugView"
                        Content="📷 相机调试"
                        Style="{StaticResource NavButtonStyle}" />
                    <Separator />
                    <Button
                        Command="{Binding NavigateCommand}"
                        CommandParameter="PlcDebugView"
                        Content="📡 通讯测试"
                        Style="{StaticResource NavButtonStyle}" />
                    <Separator />
                    <Button
                        Command="{Binding NavigateCommand}"
                        CommandParameter="ProtocolConfigView"
                        Content="📊 报文测试"
                        Style="{StaticResource NavButtonStyle}" />
                    <Separator />
                    <Button
                        Command="{Binding NavigateCommand}"
                        CommandParameter="StationConfigView"
                        Content="🗂️ 映射配置"
                        Style="{StaticResource NavButtonStyle}" />
                    <Separator />
                    <Button
                        Command="{Binding NavigateCommand}"
                        CommandParameter="HistoryRecordView"
                        Content="📋 历史记录"
                        Style="{StaticResource NavButtonStyle}" />
                    <Button
                        Command="{Binding NavigateCommand}"
                        CommandParameter="TempAndCaliDebugView"
                        Content="📋 模型创建"
                        Style="{StaticResource NavButtonStyle}" />
                </StackPanel>

                <TextBlock
                    Grid.Row="2"
                    Margin="0,12"
                    HorizontalAlignment="Center"
                    FontSize="10"
                    Foreground="#666"
                    Text="v1.0.0" />
            </Grid>
        </Border>

        <ContentControl
            Grid.Column="1"
            prism:RegionManager.RegionName="MainContentRegion"
            Background="#F5F5F5" />
        <Border
            Grid.Column="2"
            Padding="0"
            Background="#1E1E1E"
            CornerRadius="8,0,0,8">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    Margin="0,0,0,10"
                    Padding="12"
                    Background="#2D2D30"
                    CornerRadius="6">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,8"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="#F0F0F0"
                            Text="当前检测结果" />
                        <!--  占位  -->
                        <UniformGrid Columns="2" Rows="2">
                            <!--  检测总数  -->
                            <StackPanel Margin="4">
                                <TextBlock
                                    FontSize="12"
                                    Foreground="#999"
                                    Text="检测总数" />
                                <TextBlock
                                    FontSize="20"
                                    FontWeight="Bold"
                                    Foreground="#4CAF50"
                                    Text="120" />
                            </StackPanel>
                            <!--  良品数  -->
                            <StackPanel Margin="4">
                                <TextBlock
                                    FontSize="12"
                                    Foreground="#999"
                                    Text="良品数" />
                                <TextBlock
                                    FontSize="20"
                                    FontWeight="Bold"
                                    Foreground="#2196F3"
                                    Text="118" />
                            </StackPanel>
                            <!--  不良  -->
                            <StackPanel Margin="4">
                                <TextBlock
                                    FontSize="12"
                                    Foreground="#999"
                                    Text="不良品数" />
                                <TextBlock
                                    FontSize="20"
                                    FontWeight="Bold"
                                    Foreground="#F44336"
                                    Text="2" />
                            </StackPanel>
                            <!--  良率  -->
                            <StackPanel Margin="4">
                                <TextBlock
                                    FontSize="12"
                                    Foreground="#999"
                                    Text="良率" />
                                <TextBlock
                                    FontSize="20"
                                    FontWeight="Bold"
                                    Foreground="#FF9800"
                                    Text="98.3%" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border
                    Grid.Row="1"
                    Height="1"
                    Margin="0,0,0,10"
                    Background="#444" />

                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel
                        Grid.Row="0"
                        Margin="0,0,0,8"
                        Orientation="Horizontal">
                        <Ellipse
                            Width="10"
                            Height="10"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Fill="#4CAF50" />
                        <TextBlock
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="#F0F0F0"
                            Text="系统日志" />
                    </StackPanel>

                    <DataGrid
                        Grid.Row="1"
                        AutoGenerateColumns="False"
                        Background="#252526"
                        BorderThickness="0"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        GridLinesVisibility="Horizontal"
                        HeadersVisibility="Column"
                        HorizontalGridLinesBrush="#333"
                        IsReadOnly="True"
                        ItemsSource="{Binding LogSource}"
                        RowHeaderWidth="0"
                        SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="70"
                                Binding="{Binding Timestamp, StringFormat='HH:mm:ss'}"
                                Header="时间" />
                            <DataGridTextColumn
                                Width="45"
                                Binding="{Binding Level}"
                                Header="级别">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding Color}" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Message}"
                                Header="内容">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                        <Setter Property="Margin" Value="0,4" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>