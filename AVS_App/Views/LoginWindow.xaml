<Window
    x:Class="AVS_App.Views.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    Title="登录"
    Width="300"
    Height="500"
    prism:ViewModelLocator.AutoWireViewModel="True"
    AllowsTransparency="True"
    Background="Transparent"
    IsEnabled="{Binding IsUIEnabled}"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">

    <Border
        Margin="10"
        Background="White"
        CornerRadius="12"
        MouseDown="DragWindow_MouseDown">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="15"
                Direction="270"
                Opacity="0.2"
                ShadowDepth="2"
                Color="Black" />
        </Border.Effect>

        <Grid Margin="20,25,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <hc:Gravatar
                Grid.Row="0"
                Width="80"
                Height="80"
                Margin="0,10,0,20"
                HorizontalAlignment="Center"
                Id="{Binding LoginParams.UserName}" />
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <ComboBox
                    Height="35"
                    hc:InfoElement.Placeholder="请选择用户名"
                    ItemsSource="{Binding UserNames}"
                    SelectedItem="{Binding SelectedUserName}" />
                <hc:PasswordBox
                    x:Name="txtPassword"
                    Height="35"
                    Margin="0,15,0,0"
                    hc:InfoElement.Placeholder="请输入密码"
                    IsSafeEnabled="False"
                    ShowEyeButton="True"
                    UnsafePassword="{Binding LoginParams.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <!--  记住密码 / 自动登录  -->
                <Grid Margin="0,15,0,0">
                    <CheckBox
                        HorizontalAlignment="Left"
                        Content="记住密码"
                        FontSize="12"
                        IsChecked="{Binding LoginParams.IsRememberPassword}" />
                    <CheckBox
                        HorizontalAlignment="Right"
                        Content="自动登录"
                        FontSize="12"
                        IsChecked="{Binding LoginParams.IsAutoLogin}" />
                </Grid>

                <!--  错误提示信息  -->
                <TextBlock
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="#F56C6C"
                    Text="{Binding LoginParams.AlertInfo}"
                    TextWrapping="Wrap"
                    Visibility="{Binding LoginParams.IsAlertVisible}" />

                <!--  按钮行：登录和取消并排  -->
                <Grid Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Grid.Column="0"
                        Height="35"
                        Background="#67C23A"
                        BorderThickness="0"
                        Command="{Binding LoginCommand}"
                        Content="{Binding LoginButtonText}"
                        Foreground="White"
                        IsDefault="True" />
                    <Button
                        Grid.Column="2"
                        Height="35"
                        Background="#F56C6C"
                        BorderThickness="0"
                        Command="{Binding ExitCommand}"
                        Content="取 消"
                        Foreground="White"
                        IsCancel="True" />
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>