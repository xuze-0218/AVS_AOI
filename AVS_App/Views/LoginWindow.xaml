<Window
    x:Class="AVS_App.Views.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    Title="LoginWindow"
    Width="240"
    Height="450"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">
    <Grid>
        <!--  页面布局  -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>
        <!--  圆形头像  -->
        <hc:Gravatar
            Grid.Row="1"
            Grid.RowSpan="4"
            Grid.Column="2"
            Grid.ColumnSpan="2"
            Id="{Binding LoginParams.UserName}" />

        <!--  用户名  -->
        <hc:TextBox
            Grid.Row="5"
            Grid.RowSpan="2"
            Grid.Column="1"
            Grid.ColumnSpan="4"
            Height="30"
            Margin="0,12,0,0"
            VerticalAlignment="Top"
            hc:InfoElement.Placeholder="用户名"
            Background="Green"
            Text="{Binding LoginParams.UserName}" />

        <!--  密码  -->
        <hc:PasswordBox
            x:Name="txtPassword"
            Grid.Row="6"
            Grid.RowSpan="2"
            Grid.Column="1"
            Grid.ColumnSpan="4"
            Height="30"
            Margin="0,25,0,2"
            VerticalAlignment="Center"
            hc:InfoElement.Placeholder="密码"
            Background="Green"
            IsSafeEnabled="False"
            ShowEyeButton="True"
            UnsafePassword="{Binding LoginParams.Password}" />

        <!--  记住密码  -->
        <CheckBox
            Grid.Row="8"
            Grid.Column="1"
            Grid.ColumnSpan="2"
            Margin="0,10,0,0"
            HorizontalAlignment="Left"
            Content="记住密码"
            FontSize="10"
            IsChecked="True" />

        <!--  自动登陆  -->
        <CheckBox
            Grid.Row="8"
            Grid.Column="3"
            Grid.ColumnSpan="2"
            Margin="0,10,0,0"
            HorizontalAlignment="Right"
            Content="自动登陆"
            FontSize="10"
            IsChecked="True" />

        <!--  登陆按钮  -->
        <Button
            Grid.Row="9"
            Grid.RowSpan="2"
            Grid.Column="1"
            Grid.ColumnSpan="4"
            Width="160"
            Height="30"
            Margin="0,13,0,0"
            VerticalAlignment="Top"
            Command="{Binding LoginCommonCommand}"
            CommandParameter="Login"
            Content="登陆"
            IsDefault="True" />

        <!--  取消按钮  -->
        <Button
            Grid.Row="10"
            Grid.RowSpan="2"
            Grid.Column="1"
            Grid.ColumnSpan="4"
            Width="160"
            Height="30"
            Margin="0,24,0,0"
            VerticalAlignment="Top"
            Command="{Binding LoginCommonCommand}"
            CommandParameter="Exit"
            Content="取消" />

        <!--  忘记密码 Forgot password?  -->
        <TextBlock
            x:Name="txtFogetPwd"
            Grid.Row="12"
            Grid.Column="3"
            Grid.ColumnSpan="2"
            Width="Auto"
            Margin="0,7,2,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Cursor="Hand"
            FontSize="9"
            Foreground="Gray"
            Text="忘记密码?"
            TextDecorations="Underline"
            TextWrapping="Wrap">
            <!--  事件绑定  -->
            <!--<hc:Interaction.Triggers>
            <hc:EventTrigger EventName="PreviewMouseLeftButtonDown">
                <hc:InvokeCommandAction Command="{Binding PreviewMouseLeftButtonDownCommand}" CommandParameter="{Binding ElementName=txtFogetPwd}" />
            </hc:EventTrigger>
        </hc:Interaction.Triggers>-->
        </TextBlock>

        <!--  提示信息  -->
        <TextBlock
            Grid.Row="13"
            Grid.Column="1"
            Grid.ColumnSpan="4"
            Width="156"
            Margin="0,8,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            FontSize="9"
            Foreground="Red"
            Text="{Binding LoginParams.AlertInfo}"
            TextWrapping="Wrap"
            Visibility="{Binding LoginParams.IsVisibility}" />

    </Grid>
</Window>