<Window
    x:Class="AVS_App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:AVS_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    Title="MainWindow"
    Width="800"
    Height="450"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#2D2D30">
            <StackPanel Margin="0,20,0,0">
                <TextBlock
                    Margin="0,0,0,30"
                    HorizontalAlignment="Center"
                    FontSize="20"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="AOI 导航菜单" />

                <Button
                    Height="40"
                    Margin="10,5"
                    Background="#3E3E42"
                    BorderThickness="0"
                    Command="{Binding NavigateCommand}"
                    CommandParameter="ParameterConfigView"
                    Content="⚙️ 参数配置"
                    FontSize="16"
                    Foreground="White" />

                <Button
                    Height="40"
                    Margin="10,5"
                    Background="#3E3E42"
                    BorderThickness="0"
                    Command="{Binding NavigateCommand}"
                    CommandParameter="CameraDebugView"
                    Content="📷 相机调试"
                    FontSize="16"
                    Foreground="White" />

                <Button
                    Height="40"
                    Margin="10,5"
                    Background="#3E3E42"
                    BorderThickness="0"
                    Command="{Binding NavigateCommand}"
                    CommandParameter="HistoryRecordView"
                    Content="📊 历史记录"
                    FontSize="16"
                    Foreground="White" />
            </StackPanel>
        </Border>

        <ContentControl Grid.Column="1" prism:RegionManager.RegionName="MainContentRegion" />

    </Grid>
</Window>
