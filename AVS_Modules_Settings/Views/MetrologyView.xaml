<UserControl
    x:Class="AVS_Modules_Settings.Views.MetrologyView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:AVS_Modules_Settings.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!--  ================= 参数行 =================  -->
        <Style x:Key="ParamLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

        <Style x:Key="ParamTextBox" TargetType="TextBox">
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="ParamComboBox" TargetType="ComboBox">
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="InlineCheckBox" TargetType="CheckBox">
            <Setter Property="Margin" Value="0,2,10,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ParamExpander" TargetType="Expander">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="ParamGrid" TargetType="Grid">
            <Setter Property="Margin" Value="4" />
        </Style>

        <!--  ================= 按钮 =================  -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#757575" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style
            x:Key="PrimaryActionButton"
            BasedOn="{StaticResource ActionButton}"
            TargetType="Button">
            <Setter Property="Background" Value="#1976D2" />
        </Style>

        <Style
            x:Key="SmallActionButton"
            BasedOn="{StaticResource ActionButton}"
            TargetType="Button">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="8,3" />
        </Style>
    </UserControl.Resources>

    <StackPanel Background="AliceBlue">

        <!--  ============ 顶部：测量按钮 + 状态 ============  -->
        <Border
            Margin="0,0,0,6"
            Padding="6"
            Background="#E3F2FD"
            BorderBrush="#1976D2"
            BorderThickness="1"
            CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    Command="{Binding MeasureCommand}"
                    Content="测量"
                    Style="{StaticResource PrimaryActionButton}" />

                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Text="{Binding StatusMessage}"
                    TextWrapping="Wrap" />
            </Grid>
        </Border>

        <!--  ============ 测量参数 ============  -->
        <Expander
            Header="测量参数"
            IsExpanded="True"
            Style="{StaticResource ParamExpander}">
            <StackPanel>

                <!--  开关 + 按钮行  -->
                <WrapPanel Margin="4,4,4,0">
                    <CheckBox
                        Content="边缘对模式"
                        IsChecked="{Binding UseEdgePairs}"
                        Style="{StaticResource InlineCheckBox}"
                        ToolTip="仅对矩形2有效" />
                    <CheckBox
                        Content="跟随模板"
                        IsChecked="{Binding IsFollowModel}"
                        Style="{StaticResource InlineCheckBox}" />
                    <Button
                        Command="{Binding SaveMetroCommand}"
                        Content="保存模型"
                        Style="{StaticResource SmallActionButton}" />
                    <Button
                        Command="{Binding LoadMetroCommand}"
                        Content="加载模型"
                        Style="{StaticResource SmallActionButton}" />
                </WrapPanel>

                <!--  测框长度  -->
                <Grid Style="{StaticResource ParamGrid}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="85" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Style="{StaticResource ParamLabel}"
                        Text="测框长1:" />
                    <TextBox
                        Grid.Row="0"
                        Grid.Column="1"
                        Style="{StaticResource ParamTextBox}"
                        Text="{Binding MeasureLength1, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Style="{StaticResource ParamLabel}"
                        Text="测框长2:" />
                    <TextBox
                        Grid.Row="1"
                        Grid.Column="1"
                        Style="{StaticResource ParamTextBox}"
                        Text="{Binding MeasureLength2, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </StackPanel>
        </Expander>

        <!--  ============ 边缘参数 ============  -->
        <Expander
            Header="边缘参数"
            IsExpanded="True"
            Style="{StaticResource ParamExpander}">
            <Grid Style="{StaticResource ParamGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="85" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Style="{StaticResource ParamLabel}"
                    Text="Sigma:" />
                <TextBox
                    Grid.Row="0"
                    Grid.Column="1"
                    Style="{StaticResource ParamTextBox}"
                    Text="{Binding Sigma, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Style="{StaticResource ParamLabel}"
                    Text="阈值:" />
                <TextBox
                    Grid.Row="1"
                    Grid.Column="1"
                    Style="{StaticResource ParamTextBox}"
                    Text="{Binding Threshold, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    Style="{StaticResource ParamLabel}"
                    Text="最小分数:" />
                <TextBox
                    Grid.Row="2"
                    Grid.Column="1"
                    Style="{StaticResource ParamTextBox}"
                    Text="{Binding MinScore, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock
                    Grid.Row="3"
                    Grid.Column="0"
                    Style="{StaticResource ParamLabel}"
                    Text="实例个数:" />
                <TextBox
                    Grid.Row="3"
                    Grid.Column="1"
                    Style="{StaticResource ParamTextBox}"
                    Text="{Binding NumInstances, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock
                    Grid.Row="4"
                    Grid.Column="0"
                    Style="{StaticResource ParamLabel}"
                    Text="测量间距:" />
                <TextBox
                    Grid.Row="4"
                    Grid.Column="1"
                    Style="{StaticResource ParamTextBox}"
                    Text="{Binding MeasureDistance, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock
                    Grid.Row="5"
                    Grid.Column="0"
                    Style="{StaticResource ParamLabel}"
                    Text="插值方式:" />
                <ComboBox
                    Grid.Row="5"
                    Grid.Column="1"
                    ItemsSource="{Binding InterpolationOptions}"
                    SelectedItem="{Binding SelectedInterpolation}"
                    Style="{StaticResource ParamComboBox}" />
            </Grid>
        </Expander>

        <!--  ============ 边缘过滤 ============  -->
        <Expander
            Header="边缘过滤"
            IsExpanded="False"
            Style="{StaticResource ParamExpander}">
            <Grid Style="{StaticResource ParamGrid}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="85" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Style="{StaticResource ParamLabel}"
                    Text="过渡极性:" />
                <ComboBox
                    Grid.Row="0"
                    Grid.Column="1"
                    ItemsSource="{Binding TransitionOptions}"
                    SelectedItem="{Binding SelectedTransition}"
                    Style="{StaticResource ParamComboBox}" />

                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Style="{StaticResource ParamLabel}"
                    Text="边缘选择:" />
                <ComboBox
                    Grid.Row="1"
                    Grid.Column="1"
                    ItemsSource="{Binding SelectOptions}"
                    SelectedItem="{Binding SelectedSelect}"
                    Style="{StaticResource ParamComboBox}" />
            </Grid>
        </Expander>

        <!--  ============ 显示选项 ============  -->
        <Expander
            Header="显示选项"
            IsExpanded="False"
            Style="{StaticResource ParamExpander}">
            <WrapPanel Margin="4">
                <CheckBox
                    Content="显示测量线"
                    IsChecked="{Binding ShowMeasures}"
                    Style="{StaticResource InlineCheckBox}" />
                <CheckBox
                    Content="显示结果轮廓"
                    IsChecked="{Binding ShowResultContour}"
                    Style="{StaticResource InlineCheckBox}" />
            </WrapPanel>
        </Expander>

        <!--  ============ 测量结果 ============  -->
        <TextBlock
            Margin="0,8,0,2"
            FontWeight="Bold"
            Text="测量结果:" />
        <DataGrid
            MaxHeight="180"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            IsReadOnly="True"
            ItemsSource="{Binding CaliperResults}">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="30"
                    Binding="{Binding Index}"
                    Header="#" />
                <DataGridTextColumn
                    Width="50"
                    Binding="{Binding Row, StringFormat=F2}"
                    Header="Row" />
                <DataGridTextColumn
                    Width="50"
                    Binding="{Binding Col, StringFormat=F2}"
                    Header="Col" />
                <DataGridTextColumn
                    Width="55"
                    Binding="{Binding Amplitude, StringFormat=F2}"
                    Header="幅值" />
                <DataGridTextColumn
                    Width="65"
                    Binding="{Binding Distance, StringFormat=F2}"
                    Header="边缘对宽" />
                <DataGridTextColumn
                    Width="60"
                    Binding="{Binding InterDistance, StringFormat=F2}"
                    Header="对间距" />
            </DataGrid.Columns>
        </DataGrid>
    </StackPanel>
</UserControl>