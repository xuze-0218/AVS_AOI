<UserControl
    x:Class="AVS_Modules_Settings.Views.TempAndCaliDebugView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="clr-namespace:AVS_Common;assembly=AVS_Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:AVS_Modules_Settings.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:Height="1000"
    d:Width="1600"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Background="AliceBlue">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ToolBar Grid.Row="0" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
            <Button Command="{Binding LoadImageCommand}" Content="加载图像" />
            <Separator />
            <Button
                Command="{Binding RunCommand}"
                Content="▶ 执行"
                FontWeight="Bold" />

            <Separator />
            <ToggleButton
                Content="👁 ROI"
                IsChecked="{Binding IsRoiVisible}"
                ToolTip="显示/隐藏绿色 ROI 区域" />
            <Separator />
            <Button Command="{Binding SaveRoiCommand}" Content="保存ROI" />
            <Button Command="{Binding LoadRoiCommand}" Content="加载ROI" />
            <Button Command="{Binding ClearRoiCommand}" Content="清除ROI" />
            <Separator />
            <Button
                Command="{Binding ConfirmRoiCommand}"
                Content="确认ROI"
                ToolTip="将可拖动红色框转为绿色固定区域" />
        </ToolBar>

        <!--  主内容区  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <!--  图像显示区（含右键菜单）  -->
            <common:CameraDisplayUnit
                x:Name="CameraDisplay"
                Grid.Column="0"
                DispImage="{Binding CurrentImage}"
                DispRegion="{Binding CurrentRegionDisplay}"
                Loaded="CameraDisplay_Loaded">
                <common:CameraDisplayUnit.ContextMenu>
                    <ContextMenu>
                        <MenuItem
                            Command="{Binding DrawRect1Command}"
                            Header="矩形1 (Rectangle1)"
                            ToolTip="轴向对齐矩形" />
                        <MenuItem
                            Command="{Binding DrawRect2Command}"
                            Header="矩形2 (Rectangle2)"
                            ToolTip="可旋转矩形 → 卡尺测量" />
                        <MenuItem Command="{Binding DrawCircleCommand}" Header="圆形 (Circle)" />
                        <MenuItem Command="{Binding DrawEllipseCommand}" Header="椭圆 (Ellipse)" />
                        <MenuItem Command="{Binding DrawLineCommand}" Header="直线 (Line)" />
                        <MenuItem Command="{Binding DrawPolygonCommand}" Header="多边形 (Polygon)" />
                        <Separator />
                        <MenuItem Command="{Binding ClearDrawingCommand}" Header="清除绘制" />
                    </ContextMenu>
                </common:CameraDisplayUnit.ContextMenu>
            </common:CameraDisplayUnit>

            <GridSplitter
                Grid.Column="1"
                Width="5"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" />

            <!--  右侧参数面板：嵌入子视图  -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8">
                    <!--  模板匹配分组  -->
                    <Border
                        Margin="0,0,0,6"
                        Padding="6,3"
                        Background="#FFE3F2FD"
                        BorderBrush="#FF2196F3"
                        BorderThickness="1"
                        CornerRadius="3">
                        <TextBlock
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="#FF0D47A1"
                            Text="📐 模板匹配" />
                    </Border>
                    <local:TemplateMatchingView DataContext="{Binding TemplateMatchingVM}" />
                    <Separator Margin="0,12,0,6" />
                    <!--  卡尺测量分组  -->
                    <Border
                        Margin="0,0,0,6"
                        Padding="6,3"
                        Background="#FFE8F5E9"
                        BorderBrush="#FF4CAF50"
                        BorderThickness="1"
                        CornerRadius="3">
                        <TextBlock
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="#FF1B5E20"
                            Text="📏 卡尺测量" />
                    </Border>
                    <local:MetrologyView DataContext="{Binding MetrologyVM}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <StatusBar Grid.Row="2" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
            <StatusBarItem Width="Auto">
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem Width="120">
                <TextBlock Text="{Binding RunTime, StringFormat='耗时: {0}'}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem Width="120">
                <TextBlock>
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPass}" Value="True">
                                    <Setter Property="Foreground" Value="Green" />
                                    <Setter Property="Text" Value="PASS" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsPass}" Value="False">
                                    <Setter Property="Foreground" Value="Red" />
                                    <Setter Property="Text" Value="FAIL" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StatusBarItem>
            <Separator />
            <StatusBarItem Width="Auto">
                <TextBlock Text="{Binding RunResult, StringFormat='结果: {0}'}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock VerticalAlignment="Center" Text="行:" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock
                    Width="60"
                    VerticalAlignment="Center"
                    Text="{Binding CurrentMouseRow, StringFormat=F1}" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock VerticalAlignment="Center" Text="列:" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock
                    Width="60"
                    VerticalAlignment="Center"
                    Text="{Binding CurrentMouseCol, StringFormat=F1}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>

</UserControl>