<UserControl
    x:Class="AVS_Modules_Settings.Views.TempAndCaliDebugView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="clr-namespace:AVS_Common;assembly=AVS_Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:AVS_Modules_Settings.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Background="#F8F9FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  ============ 工具栏 ============  -->
        <ToolBar
            Grid.Row="0"
            Padding="2"
            Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
            <Button
                Margin="2"
                Command="{Binding LoadImageCommand}"
                Content="📁 加载图像"
                ToolTip="选择图像文件" />
            <Separator />
            <Button
                Margin="2"
                Command="{Binding RunCommand}"
                Content="▶ 执行"
                FontWeight="Bold"
                ToolTip="运行所有检测流程" />
            <Separator />
            <ToggleButton
                Margin="2"
                Content="👁 ROI"
                IsChecked="{Binding IsRoiVisible}"
                ToolTip="显示/隐藏绿色 ROI 区域" />
            <Separator />
            <Button
                Margin="2"
                Command="{Binding SaveRoiCommand}"
                Content="💾 保存 ROI"
                ToolTip="保存 ROI 区域到文件" />
            <Button
                Margin="2"
                Command="{Binding LoadRoiCommand}"
                Content="📂 加载 ROI"
                ToolTip="从文件加载 ROI" />
            <Button
                Margin="2"
                Command="{Binding ClearRoiCommand}"
                Content="🗑 清除 ROI"
                ToolTip="删除当前 ROI" />
            <Separator />
            <Button
                Margin="2"
                Command="{Binding ConfirmRoiCommand}"
                Content="✔ 确认 ROI"
                ToolTip="将可拖动红色框转为绿色固定区域" />
        </ToolBar>

        <!--  ============ 主内容区 ============  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*" MinWidth="400" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition
                    Width="2.2*"
                    MinWidth="320"
                    MaxWidth="560" />
            </Grid.ColumnDefinitions>

            <!--  图像显示区  -->
            <common:CameraDisplayUnit
                x:Name="CameraDisplay"
                Grid.Column="0"
                DispImage="{Binding CurrentImage}"
                DispRegion="{Binding CurrentRegionDisplay}">
                <common:CameraDisplayUnit.ContextMenu>
                    <ContextMenu>
                        <MenuItem
                            Command="{Binding DrawRect1Command}"
                            Header="矩形1 (Rectangle1)"
                            ToolTip="轴向对齐矩形" />
                        <MenuItem
                            Command="{Binding DrawRect2Command}"
                            Header="矩形2 (Rectangle2)"
                            ToolTip="可旋转矩形 → 卡尺测量" />
                        <MenuItem Command="{Binding DrawCircleCommand}" Header="圆形 (Circle)" />
                        <MenuItem Command="{Binding DrawEllipseCommand}" Header="椭圆 (Ellipse)" />
                        <MenuItem Command="{Binding DrawLineCommand}" Header="直线 (Line)" />
                        <MenuItem Command="{Binding DrawPolygonCommand}" Header="多边形 (Polygon)" />
                        <Separator />
                        <MenuItem Command="{Binding ClearDrawingCommand}" Header="清除绘制" />
                    </ContextMenu>
                </common:CameraDisplayUnit.ContextMenu>
            </common:CameraDisplayUnit>

            <!--  分隔条  -->
            <GridSplitter
                Grid.Column="1"
                Width="5"
                MinWidth="3"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="#DDDDDD"
                Cursor="SizeWE" />

            <!--  右侧参数面板：TabControl  ============  -->
            <TabControl
                Grid.Column="2"
                Margin="0"
                Padding="0"
                Background="#FAFAFA"
                BorderBrush="#CCCCCC"
                BorderThickness="1,0,0,0">

                <TabItem Header="📐 模板匹配">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <local:TemplateMatchingView Margin="4" DataContext="{Binding TemplateMatchingVM}" />
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="📏 卡尺测量">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <local:MetrologyView Margin="4" DataContext="{Binding MetrologyVM}" />
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>

        <!--  ============ 状态栏 ============  -->
        <Border
            Grid.Row="2"
            Padding="8,3"
            Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
            BorderBrush="#CCCCCC"
            BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  状态消息  -->
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="{Binding StatusMessage}"
                    TextTrimming="CharacterEllipsis" />

                <!--  耗时  -->
                <TextBlock
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Text="{Binding RunTime, StringFormat='耗时: {0}'}" />

                <!--  判定  -->
                <TextBlock
                    Grid.Column="2"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    FontWeight="Bold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="Gray" />
                            <Setter Property="Text" Value="—" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPass}" Value="True">
                                    <Setter Property="Foreground" Value="Green" />
                                    <Setter Property="Text" Value="PASS" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsPass}" Value="False">
                                    <Setter Property="Foreground" Value="Red" />
                                    <Setter Property="Text" Value="FAIL" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!--  结果  -->
                <TextBlock
                    Grid.Column="3"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Text="{Binding RunResult, StringFormat='结果: {0}'}" />

                <!--  鼠标坐标  -->
                <TextBlock
                    Grid.Column="4"
                    Margin="20,0,0,0"
                    VerticalAlignment="Center"
                    Text="行:" />
                <TextBlock
                    Grid.Column="5"
                    Width="60"
                    VerticalAlignment="Center"
                    Text="{Binding CurrentMouseRow, StringFormat=F1}" />
                <StackPanel Grid.Column="6" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="列:" />
                    <TextBlock
                        Width="60"
                        VerticalAlignment="Center"
                        Text="{Binding CurrentMouseCol, StringFormat=F1}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>