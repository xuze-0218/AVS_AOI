<UserControl
    x:Class="AVS_Modules_Settings.Views.TempAndCaliDebugView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="clr-namespace:AVS_Common;assembly=AVS_Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:halcon="clr-namespace:HalconDotNet;assembly=halcondotnet"
    xmlns:local="clr-namespace:AVS_Modules_Settings.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ToolBar Grid.Row="0">
            <Button Command="{Binding LoadImageCommand}" Content="加载图像" />
            <Separator />
            <ToggleButton Content="掩膜编辑" IsChecked="{Binding IsMaskEditing}" />
            <StackPanel Margin="5,0" Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Text="大小:" />
                <TextBox
                    Width="40"
                    Margin="3,0"
                    Text="{Binding EraserSize, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox Width="80" SelectedItem="{Binding EraserType}">
                    <ComboBoxItem Content="rectangle" />
                    <ComboBoxItem Content="circle" />
                </ComboBox>
            </StackPanel>
            <Button Command="{Binding ClearMaskCommand}" Content="清除掩膜" />
            <Separator />
            <Button Command="{Binding CreateModelCommand}" Content="创建模板" />
            <Button Command="{Binding FindModelCommand}" Content="查找模板" />
            <Separator />
            <Button Command="{Binding ClearDrawingCommand}" Content="清除绘图" />
        </ToolBar>

        <common:CameraDisplayUnit
            x:Name="CameraDisplay"
            Grid.Row="1"
            DispImage="{Binding CurrentImage}"
            DispRegion="{Binding CurrentRegionDisplay}"
            Loaded="CameraDisplay_Loaded">
            <common:CameraDisplayUnit.ContextMenu>
                <ContextMenu>
                    <MenuItem Command="{Binding DrawRect1Command}" Header="矩形 (Rect1)" />
                    <MenuItem Command="{Binding DrawRect2Command}" Header="旋转矩形 (Rect2)" />
                    <MenuItem Command="{Binding DrawCircleCommand}" Header="圆形 (Circle)" />
                    <MenuItem Command="{Binding DrawPolygonCommand}" Header="多边形 (Polygon)" />
                    <Separator />
                    <MenuItem Command="{Binding ClearDrawingCommand}" Header="清除绘图" />
                </ContextMenu>
            </common:CameraDisplayUnit.ContextMenu>
        </common:CameraDisplayUnit>

        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>

</UserControl>
