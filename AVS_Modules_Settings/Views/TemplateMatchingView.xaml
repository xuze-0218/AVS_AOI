<UserControl
    x:Class="AVS_Modules_Settings.Views.TemplateMatchingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="600"
    d:DesignWidth="340"
    mc:Ignorable="d">

    <StackPanel Margin="0" Background="AliceBlue">
        <!--  状态消息  -->
        <Border
            Margin="2,4"
            Padding="4"
            Background="#FFF0E0"
            BorderBrush="#CCC"
            BorderThickness="1"
            CornerRadius="3">
            <TextBlock
                FontSize="12"
                Text="{Binding StatusMessage}"
                TextWrapping="Wrap" />
        </Border>

        <!--  ROI 绘制工具栏  -->
        <Border
            Margin="2,0,2,4"
            Padding="4"
            Background="#E8F0E8"
            BorderBrush="#AAA"
            BorderThickness="1"
            CornerRadius="3"
            ToolTip="鼠标右键确定区域中心">
            <StackPanel>
                <TextBlock
                    Margin="0,0,0,4"
                    FontSize="12"
                    FontWeight="Bold"
                    Text="ROI 绘制（右键图像选择形状）:" />
                <WrapPanel>
                    <Button
                        Width="70"
                        Margin="2"
                        Background="LightCoral"
                        Command="{Binding DrawRect1Command}"
                        Content="矩形1"
                        FontSize="11" />
                    <Button
                        Width="70"
                        Margin="2"
                        Background="LightGreen"
                        Command="{Binding DrawRect2Command}"
                        Content="矩形2"
                        FontSize="11" />
                    <Button
                        Width="70"
                        Margin="2"
                        Background="LightYellow"
                        Command="{Binding DrawCircleCommand}"
                        Content="圆形"
                        FontSize="11" />
                    <Button
                        Width="70"
                        Margin="2"
                        Background="Cyan"
                        Command="{Binding DrawPolygonCommand}"
                        Content="多边形"
                        FontSize="11" />
                    <Button
                        Width="70"
                        Margin="2"
                        Background="#DDD"
                        Command="{Binding ClearDrawingCommand}"
                        Content="清除绘图"
                        FontSize="11" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!--  掩膜编辑  -->
        <Border
            Margin="2,0,2,4"
            Padding="4"
            Background="#E0E0FF"
            BorderBrush="#AAA"
            BorderThickness="1"
            CornerRadius="3">
            <StackPanel>
                <TextBlock
                    Margin="0,0,0,4"
                    FontSize="12"
                    FontWeight="Bold"
                    Text="掩膜编辑:" />
                <WrapPanel Margin="0,0,0,4">
                    <CheckBox
                        Margin="2"
                        Content="掩膜编辑"
                        IsChecked="{Binding IsMaskEditing}" />
                    <CheckBox
                        Margin="2"
                        Content="擦除模式"
                        IsChecked="{Binding IsEraseMode}" />
                    <Button
                        Margin="2"
                        Background="#FF6666"
                        Command="{Binding ClearMaskCommand}"
                        Content="清除掩膜"
                        FontSize="11"
                        Foreground="White" />
                </WrapPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="75" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28" />
                        <RowDefinition Height="28" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="擦除大小:" />
                    <Slider
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="2"
                        IsSnapToTickEnabled="True"
                        Maximum="50"
                        Minimum="1"
                        TickFrequency="1"
                        Value="{Binding EraserSize}" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="擦除类型:" />
                    <ComboBox
                        Grid.Row="1"
                        Grid.Column="1"
                        Height="22"
                        Margin="2"
                        ItemsSource="{Binding EraserTypes}"
                        SelectedItem="{Binding EraserType}" />
                </Grid>
            </StackPanel>
        </Border>

        <!--  操作按钮  -->
        <Border
            Margin="2,0,2,4"
            Padding="4"
            Background="#E8E8E8"
            BorderBrush="#AAA"
            BorderThickness="1"
            CornerRadius="3">
            <WrapPanel>
                <Button
                    Width="75"
                    Margin="2"
                    Background="DodgerBlue"
                    Command="{Binding CreateModelCommand}"
                    Content="创建模板"
                    FontSize="11"
                    Foreground="White" />
                <Button
                    Width="75"
                    Margin="2"
                    Background="ForestGreen"
                    Command="{Binding FindModelCommand}"
                    Content="查找模板"
                    FontSize="11"
                    Foreground="White" />
                <Button
                    Width="75"
                    Margin="2"
                    Background="Gray"
                    Command="{Binding SaveModelCommand}"
                    Content="保存模板"
                    FontSize="11"
                    Foreground="White" />
                <Button
                    Width="75"
                    Margin="2"
                    Background="Gray"
                    Command="{Binding LoadModelCommand}"
                    Content="加载模板"
                    FontSize="11"
                    Foreground="White" />
            </WrapPanel>
        </Border>

        <!--  创建模板  -->
        <Expander
            Margin="0,0,0,4"
            Header="创建模板"
            IsExpanded="False">
            <StackPanel Margin="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="28" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="起始角度(°):" />
                    <TextBox
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="2"
                        Text="{Binding CmAngleStart, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="角度范围(°):" />
                    <TextBox
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="2"
                        Text="{Binding CmAngleExtent, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="度量方式:" />
                    <ComboBox
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="2"
                        ItemsSource="{Binding MetricOptions}"
                        SelectedItem="{Binding CmMetric}" />

                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="对比度低:" />
                    <TextBox
                        Grid.Row="3"
                        Grid.Column="1"
                        Margin="2"
                        Text="{Binding CmContrastLow, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="对比度高:" />
                    <TextBox
                        Grid.Row="4"
                        Grid.Column="1"
                        Margin="2"
                        Text="{Binding CmContrastHigh, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Grid.Row="5"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="最小对比度:" />
                    <TextBox
                        Grid.Row="5"
                        Grid.Column="1"
                        Margin="2"
                        Text="{Binding CmMinContrast, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Grid.Row="6"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="金字塔层级:" />
                    <TextBox
                        Grid.Row="6"
                        Grid.Column="1"
                        Margin="2"
                        Text="{Binding CmNumLevels, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <StackPanel Margin="0,4">
                    <TextBlock Text="优化方式:" />
                    <ComboBox ItemsSource="{Binding OptimizationOptions}" SelectedItem="{Binding CmOptimization}" />
                    <CheckBox
                        Margin="0,2"
                        Content="自动NumLevels"
                        IsChecked="{Binding CmIsNumLevels}" />
                    <CheckBox
                        Margin="0,2"
                        Content="自动Contrast"
                        IsChecked="{Binding CmIsContrast}" />
                    <CheckBox
                        Margin="0,2"
                        Content="自动MinContrast"
                        IsChecked="{Binding CmIsMinContrast}" />
                    <TextBlock Text="最小边界:" />
                    <TextBox Text="{Binding CmMinBorder, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </StackPanel>
        </Expander>

        <!--  查找模板  -->
        <Expander
            Margin="0,0,0,4"
            Header="查找模板"
            IsExpanded="False">
            <StackPanel Margin="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="85" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="28" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="起始角度(°):" />
                    <TextBox
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="2"
                        Text="{Binding FmAngleStart, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="角度范围(°):" />
                    <TextBox
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="2"
                        Text="{Binding FmAngleExtent, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="缩放Min:" />
                    <TextBox
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="2"
                        Text="{Binding FmScaleMin, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="缩放Max:" />
                    <TextBox
                        Grid.Row="3"
                        Grid.Column="1"
                        Margin="2"
                        Text="{Binding FmScaleMax, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="匹配数量:" />
                    <TextBox
                        Grid.Row="4"
                        Grid.Column="1"
                        Margin="2"
                        Text="{Binding FmNumMatches, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Grid.Row="5"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="最小分数:" />
                    <TextBox
                        Grid.Row="5"
                        Grid.Column="1"
                        Margin="2"
                        Text="{Binding FmMinScore, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Grid.Row="6"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="最大重叠:" />
                    <TextBox
                        Grid.Row="6"
                        Grid.Column="1"
                        Margin="2"
                        Text="{Binding FmMaxOverlap, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Grid.Row="7"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="贪婪度:" />
                    <TextBox
                        Grid.Row="7"
                        Grid.Column="1"
                        Margin="2"
                        Text="{Binding FmGreediness, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Grid.Row="8"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="亚像素:" />
                    <ComboBox
                        Grid.Row="8"
                        Grid.Column="1"
                        Margin="2"
                        ItemsSource="{Binding SubPixelOptions}"
                        SelectedItem="{Binding FmSubPixel}" />

                    <TextBlock
                        Grid.Row="9"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="金字塔层级:" />
                    <TextBox
                        Grid.Row="9"
                        Grid.Column="1"
                        Margin="2"
                        Text="{Binding FmNumLevels, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </StackPanel>
        </Expander>

        <!--  显示选项  -->
        <Expander
            Margin="0,0,0,4"
            Header="显示选项"
            IsExpanded="False">
            <StackPanel Margin="4">
                <CheckBox Content="XLD轮廓模式" IsChecked="{Binding IsModeXld}" />
                <CheckBox Content="显示十字" IsChecked="{Binding IsCross}" />
                <CheckBox Content="显示ROI" IsChecked="{Binding IsDispRoi}" />
            </StackPanel>
        </Expander>

        <!--  判定条件  -->
        <Expander
            Margin="0,0,0,4"
            Header="判定条件"
            IsExpanded="False">
            <StackPanel Margin="4">
                <CheckBox Content="分数判定" IsChecked="{Binding IsScoreJudge}" />
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="85" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28" />
                        <RowDefinition Height="28" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="分数下限:" />
                    <TextBox
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="2"
                        Text="{Binding LowScore, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="分数上限:" />
                    <TextBox
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="2"
                        Text="{Binding HighScore, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <CheckBox
                    Margin="0,4,0,0"
                    Content="数量判定"
                    IsChecked="{Binding IsNumsJudge}" />
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="85" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28" />
                        <RowDefinition Height="28" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="数量下限:" />
                    <TextBox
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="2"
                        Text="{Binding LowNums, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="数量上限:" />
                    <TextBox
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="2"
                        Text="{Binding HighNums, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </StackPanel>
        </Expander>

        <!--  模板路径  -->
        <StackPanel Margin="0,4">
            <TextBlock Text="模板路径:" />
            <TextBox IsReadOnly="True" Text="{Binding ModelPath, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <!--  匹配结果表格  -->
        <TextBlock
            Margin="0,4,0,2"
            FontWeight="Bold"
            Text="匹配结果:" />
        <DataGrid
            MaxHeight="150"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            IsReadOnly="True"
            ItemsSource="{Binding MatchResults}">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="40"
                    Binding="{Binding Index}"
                    Header="#" />
                <DataGridTextColumn
                    Width="50"
                    Binding="{Binding Row, StringFormat=F2}"
                    Header="Row" />
                <DataGridTextColumn
                    Width="50"
                    Binding="{Binding Col, StringFormat=F2}"
                    Header="Col" />
                <DataGridTextColumn
                    Width="50"
                    Binding="{Binding Angle, StringFormat=F2}"
                    Header="Angle" />
                <DataGridTextColumn
                    Width="55"
                    Binding="{Binding Score, StringFormat=F3}"
                    Header="Score" />
            </DataGrid.Columns>
        </DataGrid>
    </StackPanel>

</UserControl>