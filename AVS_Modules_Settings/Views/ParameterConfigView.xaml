<UserControl
    x:Class="AVS_Modules_Settings.Views.ParameterConfigView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converts="clr-namespace:AVS_Common.Converts;assembly=AVS_Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  原有样式保持不变  -->
        <Style x:Key="EnumComboStyle" TargetType="ComboBox">
            <Setter Property="ItemsSource" Value="{Binding DataContext.DataTypeValues, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
        </Style>
        <Style x:Key="GroupItemStyle" TargetType="{x:Type GroupItem}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GroupItem}">
                        <Expander
                            Background="#F2F2F2"
                            BorderBrush="#CCCCCC"
                            BorderThickness="0,0,0,1"
                            IsExpanded="True">
                            <Expander.Header>
                                <StackPanel Margin="5,2" Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontWeight="Bold"
                                        Foreground="#555555"
                                        Text="模块: " />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontWeight="Bold"
                                        Foreground="#007ACC"
                                        Text="{Binding Name}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="Gray"
                                        Text="{Binding ItemCount, StringFormat=' ({0} 个参数)'}" />
                                </StackPanel>
                            </Expander.Header>
                            <ItemsPresenter />
                        </Expander>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <converts:BoolToBorderConverter x:Key="BoolToBorderConverter" />
        <converts:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>


    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  ========== Section 选择栏 ==========  -->
        <Border
            Grid.Row="0"
            Margin="0,0,0,10"
            Padding="10"
            Background="White"
            CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Margin="5"
                    VerticalAlignment="Center"
                    Text="当前 Section:" />
                <ComboBox
                    Grid.Column="1"
                    Margin="5"
                    VerticalContentAlignment="Center"
                    IsEditable="False"
                    ItemsSource="{Binding SectionList}"
                    SelectedItem="{Binding SelectedSection}" />

                <TextBlock
                    Grid.Column="2"
                    Margin="10,5"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="Gray"
                    Text="切换Section刷新基础参数" />

                <Button
                    Grid.Column="3"
                    Width="100"
                    Margin="5,0"
                    Background="#FFF0F0"
                    Command="{Binding DeleteSectionCommand}"
                    Content="删除当前Section"
                    Foreground="#D32F2F" />
                <Button
                    Grid.Column="4"
                    Margin="5"
                    Padding="10,5"
                    Background="#D4EDDA"
                    Command="{Binding SaveCommand}"
                    Content="保存全部" />
            </Grid>
        </Border>

        <!--  ========== 分类 TabControl ==========  -->
        <TabControl Grid.Row="1" Background="White" SelectionChanged="TabControl_SelectionChanged">

            <TabItem Header="基础参数">
                <Grid MinHeight="200" Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DataGrid
                        x:Name="ParamGrid"
                        HorizontalAlignment="Stretch"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        HeadersVisibility="Column"
                        ItemsSource="{Binding ParametersView}"
                        SelectedItem="{Binding SelectedParameter}"
                        SelectionMode="Single">

                        <DataGrid.GroupStyle>
                            <GroupStyle ContainerStyle="{StaticResource GroupItemStyle}" />
                        </DataGrid.GroupStyle>

                        <DataGrid.Columns>
                            <!--  所属模块  -->
                            <DataGridTextColumn
                                Width="*"
                                MinWidth="80"
                                Binding="{Binding ModuleName}"
                                Foreground="#007ACC"
                                Header="所属模块" />

                            <!--  名称  -->
                            <DataGridTextColumn
                                Width="1.5*"
                                MinWidth="80"
                                Binding="{Binding Name}"
                                Header="名称" />

                            <!--  表达式  -->
                            <DataGridTextColumn
                                Width="3*"
                                MinWidth="100"
                                Binding="{Binding Expression}"
                                Header="表达式" />

                            <!--  注释：设为 * 宽度，填满剩余空间  -->
                            <DataGridTextColumn
                                Width="3*"
                                MinWidth="80"
                                Binding="{Binding Note}"
                                Header="注释" />

                            <!--  初始值  -->
                            <DataGridTextColumn
                                Width="*"
                                MinWidth="60"
                                Binding="{Binding InitValue}"
                                Header="初始值" />

                            <!--  输出类型  -->
                            <DataGridComboBoxColumn
                                Width="*"
                                MinWidth="80"
                                EditingElementStyle="{StaticResource EnumComboStyle}"
                                ElementStyle="{StaticResource EnumComboStyle}"
                                Header="输出类型"
                                SelectedItemBinding="{Binding OutputType}" />

                            <!--  删除按钮列 -->
                            <DataGridTemplateColumn
                                Width="*"
                                Header="操作">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{Binding DataContext.DeleteCommand, ElementName=ParamGrid}"
                                            CommandParameter="{Binding}"
                                            Content="Del"
                                            Foreground="Red" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel
                        Grid.Row="1"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <Button
                            Width="40"
                            Margin="5,0"
                            Command="{Binding AddCommand}"
                            Content="+" />
                        <Button
                            Width="90"
                            Margin="5,0"
                            Background="#FF3C3C3C"
                            Command="{Binding SaveCommand}"
                            Content="保存配置"
                            Foreground="White" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="产品参数">
                <Grid MinHeight="200" Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DataGrid
            x:Name="ProductParamGrid"
            HorizontalAlignment="Stretch"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            HeadersVisibility="Column"
            ItemsSource="{Binding ProductParametersView}"
            SelectedItem="{Binding SelectedProductParameter}"
            SelectionMode="Single">

                        <DataGrid.Columns>
                            <!--  类别  -->
                            <DataGridTextColumn
                    Width="Auto"
                    MinWidth="80"
                    Binding="{Binding Category}"
                    Foreground="#007ACC"
                    Header="类别" />

                            <!--  名称  -->
                            <DataGridTextColumn
                    Width="*"
                    MinWidth="80"
                    Binding="{Binding Name}"
                    Header="名称" />

                            <!--  说明  -->
                            <DataGridTextColumn
                    Width="*"
                    MinWidth="100"
                    Binding="{Binding Description}"
                    Header="说明" />

                            <!--  数值  -->
                            <DataGridTextColumn
                    Width="*"
                    MinWidth="60"
                    Binding="{Binding Value}"   
                    Header="数值" />

                            <!--  删除按钮列  -->
                            <DataGridTemplateColumn
                    Width="Auto"
                    MinWidth="50"
                    Header="操作">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding DataContext.DeleteProductCommand, ElementName=ProductParamGrid}"
                                CommandParameter="{Binding}"
                                Content="Del"
                                Foreground="Red" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel
            Grid.Row="1"
            Margin="0,10,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
                        <Button
                Width="40"
                Margin="5,0"
                Command="{Binding AddProductCommand}"
                Content="+" />
                        <Button
                Width="90"
                Margin="5,0"
                Background="#FF3C3C3C"
                Command="{Binding SaveProductCommand}"
                Content="保存配置"
                Foreground="White" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="🔢 检测顺序">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  顶部参数栏  -->
                    <StackPanel
                        Grid.Row="0"
                        Margin="0,0,0,10"
                        Orientation="Horizontal">
                        <TextBlock
                            Margin="5"
                            VerticalAlignment="Center"
                            Text="配方:" />
                        <ComboBox
                            Width="80"
                            Margin="5"
                            VerticalContentAlignment="Center"
                            ItemsSource="{Binding RecipeList}"
                            SelectedIndex="{Binding RecipeIndex}" />
                        <TextBlock
                            Margin="5"
                            VerticalAlignment="Center"
                            Text="行数:" />
                        <TextBox
                            Width="40"
                            Margin="5"
                            VerticalContentAlignment="Center"
                            Text="{Binding GridRows}" />
                        <TextBlock
                            Margin="5"
                            VerticalAlignment="Center"
                            Text="列数:" />
                        <TextBox
                            Width="40"
                            Margin="5"
                            VerticalContentAlignment="Center"
                            Text="{Binding GridCols}" />
                        <Button
                            Margin="5"
                            Command="{Binding GenerateGridCommand}"
                            Content="生成网格" />
                    </StackPanel>

                    <!--  极柱阵列画布  -->
                    <ScrollViewer Grid.Row="1">
                        <ItemsControl ItemsSource="{Binding PoleItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="{Binding GridCols}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid
                                        Width="40"
                                        Height="40"
                                        Margin="3"
                                        Background="Transparent"
                                        MouseLeftButtonDown="PoleCircle_Click">
                                        <Ellipse
                                            Width="30"
                                            Height="30"
                                            Fill="{Binding CircleColor}"
                                            Stroke="{Binding IsSelected, Converter={StaticResource BoolToBorderConverter}}"
                                            StrokeThickness="2" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="10"
                                            Text="{Binding PoleNumber}"
                                            Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />

                                        <!--  编辑状态：透明输入框  -->
                                        <TextBox
                                            Width="28"
                                            Height="22"
                                            Padding="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            CaretBrush="Black"
                                            FontSize="10"
                                            Foreground="Black"
                                            KeyDown="PoleTextBox_KeyDown"
                                            Loaded="PoleTextBox_Loaded"
                                            LostFocus="PoleTextBox_LostFocus"
                                            Text="{Binding PoleNumber, TargetNullValue='', UpdateSourceTrigger=PropertyChanged}"
                                            Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!--  操作按钮栏  -->
                    <StackPanel
                        Grid.Row="2"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            Margin="5"
                            Command="{Binding ClearRowCommand}"
                            Content="清除当前行" />
                        <Separator Width="20" />
                        <Button
                            Margin="5"
                            Background="#D4EDDA"
                            Command="{Binding SaveToConfigCommand}"
                            Content="保存到配置" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="AI模型路径">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="5"
                        VerticalAlignment="Center"
                        Text="检测模型路径:" />
                    <TextBox
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="5"
                        Text="{Binding DetModelPath, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        Grid.Row="0"
                        Grid.Column="2"
                        Width="60"
                        Margin="5"
                        Command="{Binding BrowseDetModelCommand}"
                        Content="浏览..." />

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="5"
                        VerticalAlignment="Center"
                        Text="分割模型路径:" />
                    <TextBox
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="5"
                        Text="{Binding SegModelPaths, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        Grid.Row="1"
                        Grid.Column="2"
                        Width="60"
                        Margin="5"
                        Command="{Binding BrowseSegModelCommand}"
                        Content="浏览..." />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Margin="5"
                        VerticalAlignment="Center"
                        Text="提示:" />
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="5"
                        FontSize="11"
                        Foreground="Gray"
                        Text="分割模型路径支持多个路径，用分号 (;) 分隔。这些参数对所有工位生效。" />
                </Grid>
            </TabItem>

            <TabItem Header="图像保存">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <!-- 0 路径 -->
                            <RowDefinition Height="Auto" />
                            <!-- 1 通用设置 -->
                            <RowDefinition Height="Auto" />
                            <!-- 2 2D 分组标题 -->
                            <RowDefinition Height="Auto" />
                            <!-- 3 2D 原始图 -->
                            <RowDefinition Height="Auto" />
                            <!-- 4 2D NG图 -->
                            <RowDefinition Height="Auto" />
                            <!-- 5 2D 结果图 -->
                            <RowDefinition Height="Auto" />
                            <!-- 6 2D mask图 -->
                            <RowDefinition Height="Auto" />
                            <!-- 7 3D 分组标题 -->
                            <RowDefinition Height="Auto" />
                            <!-- 8 3D 深度图 -->
                            <RowDefinition Height="Auto" />
                            <!-- 9 3D 亮度图 -->
                            <RowDefinition Height="Auto" />
                            <!-- 10 3D NG图 -->
                            <RowDefinition Height="Auto" />
                            <!-- 10 3D 结果图 -->
                            <RowDefinition Height="Auto" />
                            <!-- 11 Mask图 -->
                            <RowDefinition Height="Auto" />
                            <!-- 12 保存天数 -->
                            <RowDefinition Height="Auto" />
                            <!-- 12 结果图保存天数 -->
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>

                        <!-- 保存路径 -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="图像保存路径:" VerticalAlignment="Center" Margin="5"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ImageSaveDir, UpdateSourceTrigger=PropertyChanged}" Margin="5"/>
                        <Button Grid.Row="0" Grid.Column="2" Content="浏览" Command="{Binding BrowseImageSaveDirCommand}" Margin="5"/>

                        <!-- 通用设置：压缩比（仅jpeg有效） -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Jpeg压缩比:" VerticalAlignment="Center" Margin="5"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ImageCompressRatio}" Width="60" HorizontalAlignment="Left" Margin="5"/>

                        <!-- 2D 分组 -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Text="2D 相机" FontWeight="Bold" Margin="5,10,5,5"/>

                        <CheckBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Content="仅保存NG样本" IsChecked="{Binding IsSave2DNGOnly}" Margin="5"/>
                       
                        
                        <CheckBox Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Content="保存原始图像" IsChecked="{Binding IsSave2DOriginal}" Margin="5"/>
                        <ComboBox Grid.Row="4" Grid.Column="2" SelectedValuePath="Content" SelectedValue="{Binding Format2DOriginal}" Margin="5">
                            <ComboBoxItem Content="bmp" Tag="Bmp"/>
                            <ComboBoxItem Content="jpeg" Tag="Jpeg"/>
                        </ComboBox> 
                       

                        <CheckBox Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Content="保存结果图像" IsChecked="{Binding IsSave2DResult}" Margin="5"/>
                        <ComboBox Grid.Row="5" Grid.Column="2" SelectedValuePath="Content" SelectedValue="{Binding Format2DNgResult}" Margin="5">
                            <ComboBoxItem Content="bmp" Tag="Bmp"/>
                            <ComboBoxItem Content="jpeg" Tag="Jpeg"/>
                        </ComboBox>

                        <CheckBox Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Content="保存Mask图像" IsChecked="{Binding IsSave2DMask}" Margin="5"/>

                        <!-- 3D 分组 -->
                        <!-- 3D 分组 -->
                        <TextBlock Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3" Text="3D 相机" FontWeight="Bold" Margin="5,10,5,5"/>

                        <!-- 仅保存NG样本开关 -->
                        <CheckBox Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3" Content="仅保存NG样本（深度图与亮度图）" IsChecked="{Binding IsSave3DNGOnly}" Margin="5"/>

                        <!-- 保存深度图像 -->
                        <CheckBox Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2" Content="保存深度图像" IsChecked="{Binding IsSave3DDepth}" Margin="5"/>
                        <ComboBox Grid.Row="9" Grid.Column="2" SelectedValuePath="Content" SelectedValue="{Binding Format3DDepth}" Margin="5">
                            <ComboBoxItem Content="tiff" Tag="Tiff"/>
                            <ComboBoxItem Content="ply" Tag="Ply"/>
                            <ComboBoxItem Content="csv" Tag="Csv"/>
                        </ComboBox>

                        <!-- 保存亮度图像 -->
                        <CheckBox Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2" Content="保存亮度图像" IsChecked="{Binding IsSave3DIntensity}" Margin="5"/>
                        <ComboBox Grid.Row="10" Grid.Column="2" SelectedValuePath="Content" SelectedValue="{Binding Format3DIntensity}" Margin="5">
                            <ComboBoxItem Content="bmp" Tag="Bmp"/>
                            <ComboBoxItem Content="jpeg" Tag="Jpeg"/>
                            <ComboBoxItem Content="tiff" Tag="Tiff"/>
                        </ComboBox>

                        <!-- 保存结果图像 -->
                        <CheckBox Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="2" Content="保存结果图像" IsChecked="{Binding IsSave3DResult}" Margin="5"/>
                        <ComboBox Grid.Row="11" Grid.Column="2" SelectedValuePath="Content" SelectedValue="{Binding Format3DResult}" Margin="5">
                            <ComboBoxItem Content="bmp" Tag="Bmp"/>
                            <ComboBoxItem Content="jpeg" Tag="Jpeg"/>
                        </ComboBox>

                        <!-- 保存Mask图像 -->
                        <CheckBox Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="3" Content="保存Mask图像" IsChecked="{Binding IsSave3DMask}" Margin="5"/>
                        <!-- 保存天数 -->
                        <TextBlock Grid.Row="13" Grid.Column="0" Text="原图保存天数:" Margin="5"/>
                        <TextBox Grid.Row="13" Grid.Column="1" Text="{Binding SaveOrnImgDays}" Width="80" HorizontalAlignment="Left" Margin="5"/>
                        <TextBlock Grid.Row="14" Grid.Column="0" Text="结果图保存天数:" Margin="5"/>
                        <TextBox Grid.Row="14" Grid.Column="1" Text="{Binding SaveRenImgDays}" Width="80" HorizontalAlignment="Left" Margin="5"/>

                   </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>