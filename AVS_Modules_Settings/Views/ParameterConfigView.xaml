<UserControl
    x:Class="AVS_Modules_Settings.Views.ParameterConfigView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converts="clr-namespace:AVS_Common.Converts;assembly=AVS_Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!--  原有样式保持不变  -->
        <Style x:Key="EnumComboStyle" TargetType="ComboBox">
            <Setter Property="ItemsSource" Value="{Binding DataContext.DataTypeValues, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
        </Style>
        <Style x:Key="GroupItemStyle" TargetType="{x:Type GroupItem}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GroupItem}">
                        <Expander
                            Background="#F2F2F2"
                            BorderBrush="#CCCCCC"
                            BorderThickness="0,0,0,1"
                            IsExpanded="False">
                            <Expander.Header>
                                <StackPanel Margin="5,2" Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontWeight="Bold"
                                        Foreground="#555555"
                                        Text="模块: " />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontWeight="Bold"
                                        Foreground="#007ACC"
                                        Text="{Binding Name}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="Gray"
                                        Text="{Binding ItemCount, StringFormat=' ({0} 个参数)'}" />
                                </StackPanel>
                            </Expander.Header>
                            <ItemsPresenter />
                        </Expander>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <converts:BoolToBorderConverter x:Key="BoolToBorderConverter" />
        <converts:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>


    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  ========== 顶部：Section 选择栏 ==========  -->
        <Border
            Grid.Row="0"
            Margin="0,0,0,10"
            Padding="10"
            Background="White"
            CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Margin="5"
                    VerticalAlignment="Center"
                    Text="当前 Section:" />
                <ComboBox
                    Grid.Column="1"
                    Margin="5"
                    VerticalContentAlignment="Center"
                    IsEditable="False"
                    ItemsSource="{Binding SectionList}"
                    SelectedItem="{Binding SelectedSection}" />

                <TextBlock
                    Grid.Column="2"
                    Margin="10,5"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="Gray"
                    Text="切换Section将刷新基础参数" />

                <Button
                    Grid.Column="3"
                    Margin="5"
                    Padding="10,5"
                    Background="#D4EDDA"
                    Command="{Binding SaveCommand}"
                    Content="保存全部" />
            </Grid>
        </Border>

        <!--  ========== 分类 TabControl ==========  -->
        <TabControl Grid.Row="1" Background="White">

            <TabItem Header="基础参数">
                <Grid MinHeight="200" Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DataGrid
                        x:Name="ParamGrid"
                        HorizontalAlignment="Stretch"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        ColumnWidth="120"
                        HeadersVisibility="Column"
                        ItemsSource="{Binding ParametersView}"
                        SelectedItem="{Binding SelectedParameter}"
                        SelectionMode="Single">
                        <DataGrid.GroupStyle>
                            <GroupStyle ContainerStyle="{StaticResource GroupItemStyle}" />
                        </DataGrid.GroupStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="120"
                                Binding="{Binding ModuleName}"
                                Foreground="#007ACC"
                                Header="所属模块" />
                            <DataGridTextColumn
                                Width="100"
                                Binding="{Binding Name}"
                                Header="名称" />
                            <DataGridTextColumn
                                Width="120"
                                Binding="{Binding Expression}"
                                Header="表达式" />
                            <DataGridTextColumn
                                Width="100"
                                Binding="{Binding Note}"
                                Header="注释" />
                            <DataGridTextColumn
                                Width="70"
                                Binding="{Binding InitValue}"
                                Header="初始值" />
                            <DataGridComboBoxColumn
                                Width="90"
                                EditingElementStyle="{StaticResource EnumComboStyle}"
                                ElementStyle="{StaticResource EnumComboStyle}"
                                Header="输出类型"
                                SelectedItemBinding="{Binding OutputType}" />
                            <DataGridTemplateColumn Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{Binding DataContext.DeleteCommand, ElementName=ParamGrid}"
                                            CommandParameter="{Binding}"
                                            Content="Del"
                                            Foreground="Red" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel
                        Grid.Row="1"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <Button
                            Width="40"
                            Margin="5,0"
                            Command="{Binding AddCommand}"
                            Content="+" />
                        <Button
                            Width="90"
                            Margin="5,0"
                            Background="#FF3C3C3C"
                            Command="{Binding SaveCommand}"
                            Content="保存配置"
                            Foreground="White" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="🔢 检测顺序">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  顶部参数栏  -->
                    <StackPanel
                        Grid.Row="0"
                        Margin="0,0,0,10"
                        Orientation="Horizontal">
                        <TextBlock
                            Margin="5"
                            VerticalAlignment="Center"
                            Text="配方:" />
                        <ComboBox
                            Width="80"
                            Margin="5"
                            VerticalContentAlignment="Center"
                            ItemsSource="{Binding RecipeList}"
                            SelectedIndex="{Binding RecipeIndex}" />
                        <TextBlock
                            Margin="5"
                            VerticalAlignment="Center"
                            Text="行数:" />
                        <TextBox
                            Width="40"
                            Margin="5"
                            VerticalContentAlignment="Center"
                            Text="{Binding GridRows}" />
                        <TextBlock
                            Margin="5"
                            VerticalAlignment="Center"
                            Text="列数:" />
                        <TextBox
                            Width="40"
                            Margin="5"
                            VerticalContentAlignment="Center"
                            Text="{Binding GridCols}" />
                        <Button
                            Margin="5"
                            Command="{Binding GenerateGridCommand}"
                            Content="生成网格" />
                    </StackPanel>

                    <!--  极柱阵列画布  -->
                    <ScrollViewer Grid.Row="1">
                        <ItemsControl ItemsSource="{Binding PoleItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="{Binding GridCols}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid
                                        Width="40"
                                        Height="40"
                                        Margin="3"
                                        Background="Transparent"
                                        MouseLeftButtonDown="PoleCircle_Click">
                                        <Ellipse
                                            Width="30"
                                            Height="30"
                                            Fill="{Binding CircleColor}"
                                            Stroke="{Binding IsSelected, Converter={StaticResource BoolToBorderConverter}}"
                                            StrokeThickness="2" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="10"
                                            Text="{Binding PoleNumber}"
                                            Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}" />

                                        <!--  编辑状态：透明输入框  -->
                                        <TextBox
                                            Width="28"
                                            Height="22"
                                            Padding="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            CaretBrush="Black"
                                            FontSize="10"
                                            Foreground="Black"
                                            KeyDown="PoleTextBox_KeyDown"
                                            Loaded="PoleTextBox_Loaded"
                                            LostFocus="PoleTextBox_LostFocus"
                                            Text="{Binding PoleNumber, TargetNullValue='', UpdateSourceTrigger=PropertyChanged}"
                                            Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!--  操作按钮栏  -->
                    <StackPanel
                        Grid.Row="2"
                        Margin="0,10,0,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            Margin="5"
                            Command="{Binding ClearRowCommand}"
                            Content="清除当前行" />
                        <Separator Width="20" />
                        <Button
                            Margin="5"
                            Background="#D4EDDA"
                            Command="{Binding SaveToConfigCommand}"
                            Content="保存到配置" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="AI模型路径">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="5"
                        VerticalAlignment="Center"
                        Text="检测模型路径:" />
                    <TextBox
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="5"
                        Text="{Binding DetModelPath, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        Grid.Row="0"
                        Grid.Column="2"
                        Width="60"
                        Margin="5"
                        Command="{Binding BrowseDetModelCommand}"
                        Content="浏览..." />

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="5"
                        VerticalAlignment="Center"
                        Text="分割模型路径:" />
                    <TextBox
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="5"
                        Text="{Binding SegModelPaths, UpdateSourceTrigger=PropertyChanged}" />
                    <Button
                        Grid.Row="1"
                        Grid.Column="2"
                        Width="60"
                        Margin="5"
                        Command="{Binding BrowseSegModelCommand}"
                        Content="浏览..." />

                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Margin="5"
                        VerticalAlignment="Center"
                        Text="提示:" />
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="5"
                        FontSize="11"
                        Foreground="Gray"
                        Text="分割模型路径支持多个路径，用分号 (;) 分隔。这些参数对所有工位生效。" />
                </Grid>
            </TabItem>

            <TabItem Header="图像保存">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>

                    <!--  保存路径  -->
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="5"
                        VerticalAlignment="Center"
                        Text="图像保存路径:" />
                    <TextBox
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="5"
                        Text="{Binding ImageSaveDir, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                    <Button
                        Grid.Row="0"
                        Grid.Column="2"
                        Margin="5,5,0,5"
                        Command="{Binding BrowseImageSaveDirCommand}"
                        Content="浏览" />

                    <!--  格式 + 压缩比（同一行，紧凑）  -->
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="5"
                        VerticalAlignment="Center"
                        Text="图像格式:" />
                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        Margin="5"
                        Orientation="Horizontal">
                        <ComboBox
                            Width="100"
                            VerticalAlignment="Center"
                            SelectedItem="{Binding ImageFormat}">
                            <ComboBoxItem Content="bmp" />
                            <ComboBoxItem Content="jpeg" />
                        </ComboBox>
                        <TextBlock
                            Margin="15,0,5,0"
                            VerticalAlignment="Center"
                            Text="压缩比:" />
                        <TextBox
                            Width="60"
                            VerticalAlignment="Center"
                            Text="{Binding ImageCompressRatio, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            Margin="3,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="Gray"
                            Text="(仅jpeg)" />
                    </StackPanel>

                    <!--  保存开关  -->
                    <CheckBox
                        Grid.Row="2"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Margin="5"
                        Content="保存原始图像"
                        IsChecked="{Binding IsSaveOrnImg}" />
                    <CheckBox
                        Grid.Row="3"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Margin="5"
                        Content="保存OK结果图像"
                        IsChecked="{Binding IsSaveOkRenImg}" />
                    <CheckBox
                        Grid.Row="4"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Margin="5"
                        Content="保存NG结果图像"
                        IsChecked="{Binding IsSaveNgRenImg}" />

                    <TextBlock
                        Grid.Row="5"
                        Grid.Column="0"
                        Margin="5"
                        VerticalAlignment="Center"
                        Text="原图保存天数:" />
                    <TextBox
                        Grid.Row="5"
                        Grid.Column="1"
                        Width="80"
                        Margin="5"
                        HorizontalAlignment="Left"
                        Text="{Binding SaveOrnImgDays, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Grid.Row="6"
                        Grid.Column="0"
                        Margin="5"
                        VerticalAlignment="Center"
                        Text="结果图保存天数:" />
                    <TextBox
                        Grid.Row="6"
                        Grid.Column="1"
                        Width="80"
                        Margin="5"
                        HorizontalAlignment="Left"
                        Text="{Binding SaveRenImgDays, UpdateSourceTrigger=PropertyChanged}" />

                    <!--  分隔线  -->
                    <Separator
                        Grid.Row="7"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Margin="5,0"
                        Background="#E0E0E0" />

                    <!--  提示信息  -->
                    <TextBlock
                        Grid.Row="8"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Margin="5"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="#333"
                        Text="说明" />

                    <TextBlock
                        Grid.Row="9"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Margin="5,0,5,5"
                        FontSize="11"
                        Foreground="#999"
                        Text="• 所有工位共享同一套图像保存配置，不随 Section 切换变化。&#x0a;• 格式选 bmp 时压缩比无效，选 jpeg 时建议压缩比 80-100。"
                        TextWrapping="Wrap" />
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>