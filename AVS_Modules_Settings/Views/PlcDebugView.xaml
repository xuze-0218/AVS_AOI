<UserControl
    x:Class="AVS_Modules_Settings.Views.PlcDebugView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converts="clr-namespace:AVS_Common.Converts;assembly=AVS_Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:AVS_Service.Models;assembly=AVS_Service"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="400"
    d:DesignWidth="800"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">
    <UserControl.Resources>
        <x:Array x:Key="ProtocolList" Type="models:CommProtocol">
            <models:CommProtocol>TCP</models:CommProtocol>
            <models:CommProtocol>UDP</models:CommProtocol>
        </x:Array>
        <x:Array x:Key="RoleList" Type="models:CommRole">
            <models:CommRole>Server</models:CommRole>
            <models:CommRole>Client</models:CommRole>
        </x:Array>
        <converts:BoolToColorConverter x:Key="BoolToColorConverter" />
    </UserControl.Resources>

    <Grid Background="AliceBlue">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10">
                <GroupBox Header="选择工位 / 新增">
                    <StackPanel Margin="5" Orientation="Horizontal">
                        <TextBlock
                            Margin="5,0"
                            VerticalAlignment="Center"
                            Text="工位：" />
                        <ComboBox
                            Width="150"
                            Margin="5,0"
                            DisplayMemberPath="StationId"
                            ItemsSource="{Binding Stations}"
                            SelectedItem="{Binding SelectedStation}" />
                        <Button
                            Margin="5,0"
                            Command="{Binding AddNewStationCommand}"
                            Content="新增工位" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Margin="0,10,0,0" Header="通讯参数">
                    <StackPanel>
                        <Grid Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="5"
                                VerticalAlignment="Center"
                                Text="IP:" />
                            <TextBox
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="5"
                                Text="{Binding CurrentIp}" />

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="2"
                                Margin="5"
                                VerticalAlignment="Center"
                                Text="端口:" />
                            <TextBox
                                Grid.Row="0"
                                Grid.Column="3"
                                Margin="5"
                                Text="{Binding CurrentPort}" />

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                Margin="5"
                                VerticalAlignment="Center"
                                Text="协议:" />
                            <ComboBox
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="5"
                                ItemsSource="{StaticResource ProtocolList}"
                                SelectedItem="{Binding CurrentProtocol}" />

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="2"
                                Margin="5"
                                VerticalAlignment="Center"
                                Text="模式:" />
                            <ComboBox
                                Grid.Row="1"
                                Grid.Column="3"
                                Margin="5"
                                ItemsSource="{StaticResource RoleList}"
                                SelectedItem="{Binding CurrentRole}" />
                        </Grid>
                        <Button
                            Margin="5"
                            Padding="10,5"
                            Background="#CCFFCC"
                            Command="{Binding SaveStationConfigCommand}"
                            Content="保存配置" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Margin="0,10,0,0" Header="连接控制">
                    <StackPanel Margin="5">
                        <StackPanel Orientation="Horizontal">
                            <Button
                                Margin="0,0,5,0"
                                Padding="10,5"
                                Command="{Binding ConnectCommand}"
                                Content="连接" />
                            <Button
                                Padding="10,5"
                                Command="{Binding DisconnectCommand}"
                                Content="断开" />
                        </StackPanel>
                        <TextBlock
                            Margin="0,5,0,0"
                            FontWeight="Bold"
                            Foreground="{Binding IsConnected, Converter={StaticResource BoolToColorConverter}}"
                            Text="{Binding StatusMessage}" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Margin="0,10,0,0" Header="发送测试报文">
                    <StackPanel>
                        <Grid Margin="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                Grid.Column="0"
                                VerticalContentAlignment="Center"
                                Text="{Binding MessageInput}" />
                            <Button
                                Grid.Column="1"
                                Margin="5,0,0,0"
                                Padding="10,5"
                                Command="{Binding SendCommand}"
                                Content="发送" />
                        </Grid>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <GroupBox
            Grid.Column="1"
            Margin="10"
            Header="接收消息">
            <DockPanel LastChildFill="True">
                <Button
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Command="{Binding ClearReceivedCommand}"
                    Content="清空"
                    DockPanel.Dock="Bottom"
                    FontSize="20" />
                <TextBox
                    x:Name="ReceivedTextLog"
                    AcceptsReturn="True"
                    Background="#2D2D30"
                    BorderThickness="0"
                    FontFamily="Consolas"
                    Foreground="Cyan"
                    HorizontalScrollBarVisibility="Disabled"
                    IsReadOnly="True"
                    Text="{Binding ReceivedMessagesText, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                    TextChanged="ReceivedTextLog_TextChanged"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto" />

            </DockPanel>
        </GroupBox>
    </Grid>
</UserControl>