<UserControl
    x:Class="AVS_Modules_Settings.Views.HistoryQueryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="clr-namespace:AVS_Common.Converts;assembly=AVS_Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:AVS_Modules_Settings.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:setConvets="clr-namespace:AVS_Modules_Settings.Converts"
    d:DesignHeight="450"
    d:DesignWidth="800"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">
    <UserControl.Resources>
        <common:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  第 1 行：日期 + 目录  -->
        <StackPanel
            Grid.Row="0"
            Margin="8"
            Orientation="Horizontal">
            <DatePicker SelectedDate="{Binding StartDate}" />
            <TextBlock VerticalAlignment="Center" Text=" ~ " />
            <DatePicker SelectedDate="{Binding EndDate}" />
            <TextBox
                Width="320"
                Margin="8,0"
                Text="{Binding RootPath}" />
            <Button
                Margin="4,0"
                Command="{Binding BrowseFolderCommand}"
                Content="浏览" />
            <Button
                Margin="4,0"
                Command="{Binding AnalyzeCommand}"
                Content="分析" />
        </StackPanel>

        <!--  第 2 行：三级联动  -->
        <StackPanel
            Grid.Row="1"
            Margin="8,0"
            Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center" Text="类型" />
            <ComboBox
                Width="80"
                Margin="4,0"
                ItemsSource="{Binding DataTypes}"
                SelectedItem="{Binding SelectedDataType}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource DataTypeNameConverter}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                Text="形状"
                Visibility="{Binding HasMultipleShapes, Converter={StaticResource BoolToVisibility}}" />
            <ComboBox
                Width="80"
                Margin="4,0"
                ItemsSource="{Binding Shapes}"
                SelectedItem="{Binding SelectedShape}"
                Visibility="{Binding HasMultipleShapes, Converter={StaticResource BoolToVisibility}}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource ShapeNameConverter}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                Text="因子" />
            <ComboBox
                Width="160"
                Margin="4,0"
                DisplayMemberPath="Name"
                ItemsSource="{Binding FactorOptions}"
                SelectedItem="{Binding SelectedFactor}" />
        </StackPanel>

        <!--  第 3 行：统计表 + 文件/错误列表  -->
        <Grid Grid.Row="2" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <DataGrid
                Grid.Column="0"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                ItemsSource="{Binding Rates}">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding Name}" Header="类型" />
                    <DataGridTextColumn Binding="{Binding Total}" Header="总数" />
                    <DataGridTextColumn Binding="{Binding OkCount}" Header="OK" />
                    <DataGridTextColumn Binding="{Binding OkRate, StringFormat=F2}" Header="OK率" />
                    <DataGridTextColumn Binding="{Binding NgCount}" Header="NG" />
                    <DataGridTextColumn Binding="{Binding NgRate, StringFormat=F2}" Header="NG率" />
                </DataGrid.Columns>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSummary}" Value="True">
                                <Setter Property="Background" Value="#DDEBF7" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>

            <TabControl Grid.Column="1">
                <TabItem Header="已加载文件">
                    <ListBox ItemsSource="{Binding LoadedFiles}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="{Binding SchemaName}" />
                                    <Run Text=" | " />
                                    <Run Text="{Binding DataRowCount}" />
                                    <Run Text=" 行 | " />
                                    <Run Text="{Binding Path}" />
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </TabItem>
                <TabItem Header="错误">
                    <ListBox ItemsSource="{Binding Errors}" />
                </TabItem>
            </TabControl>
        </Grid>

        <StatusBar Grid.Row="3">
            <StatusBarItem Content="{Binding StatusText}" />
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar Width="120" IsIndeterminate="{Binding IsLoading}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>
