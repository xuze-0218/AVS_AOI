<UserControl
    x:Class="AVS_Modules_Settings.Views.CameraDebugView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:comm="clr-namespace:AVS_Common;assembly=AVS_Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:halcon="clr-namespace:HalconDotNet;assembly=halcondotnet"
    xmlns:local="clr-namespace:AVS_Modules_Settings.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    d:DesignHeight="450"
    d:DesignWidth="800"
    prism:ViewModelLocator.AutoWireViewModel="True"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#E0E6ED" />
            <Setter Property="BorderBrush" Value="#C3D1E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="Padding" Value="10,5" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.6" />
                    <Setter Property="Background" Value="#F2F2F2" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ModernGroupBox" TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#C3D1E1" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock
                            FontWeight="Bold"
                            Foreground="#4A6176"
                            Text="{Binding}" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="AliceBlue">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Column="0"
            Margin="10"
            Background="Black"
            BorderBrush="#C3D1E1"
            BorderThickness="1"
            CornerRadius="3">
            <Grid>
                <comm:CameraDisplayUnit DispImage="{Binding CurrentDebugImage}" />

                <TextBlock
                    Margin="10"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Foreground="#00FF00"
                    Text="{Binding StatusMessage}" />
            </Grid>
        </Border>

        <ScrollViewer
            Grid.Column="1"
            Margin="5"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <GroupBox Header="设备初始化" Style="{StaticResource ModernGroupBox}">
                    <StackPanel>
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Margin="0,0,5,0"
                                VerticalAlignment="Center"
                                Text="相机品牌：" />
                            <ComboBox
                                Grid.Column="1"
                                VerticalContentAlignment="Center"
                                ItemsSource="{Binding CameraBrands}"
                                SelectedItem="{Binding SelectedBrand}" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                Grid.Column="0"
                                Margin="0,5,5,5"
                                VerticalContentAlignment="Center"
                                ItemsSource="{Binding DeviceList}"
                                SelectedItem="{Binding SelectedDevice}" />
                            <Button
                                Grid.Column="1"
                                Width="60"
                                Margin="0,5,5,5"
                                Command="{Binding SearchCommand}"
                                Content="查找"
                                Style="{StaticResource ModernButton}" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                Grid.Column="0"
                                Background="#D4EDDA"
                                BorderBrush="#C3E6CB"
                                Command="{Binding InitCommand}"
                                Content="初始化相机"
                                Style="{StaticResource ModernButton}" />
                            <Button
                                Grid.Column="1"
                                Background="#F8D7DA"
                                BorderBrush="#F5C6CB"
                                Command="{Binding CloseCommand}"
                                Content="注销相机"
                                Style="{StaticResource ModernButton}" />
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="图像采集模式" Style="{StaticResource ModernGroupBox}">
                    <StackPanel>
                        <StackPanel Margin="5" Orientation="Horizontal">
                            <RadioButton
                                Margin="0,0,15,0"
                                VerticalAlignment="Center"
                                Content="连续模式"
                                IsChecked="{Binding IsContinuousMode}" />
                            <RadioButton
                                VerticalAlignment="Center"
                                Content="触发模式"
                                IsChecked="{Binding IsTriggerMode}" />
                        </StackPanel>

                        <StackPanel
                            Margin="5"
                            IsEnabled="{Binding IsTriggerMode}"
                            Orientation="Horizontal">
                            <TextBlock
                                Width="60"
                                VerticalAlignment="Center"
                                Text="触发源：" />
                            <ComboBox
                                Width="165"
                                ItemsSource="{Binding TriggerSources}"
                                SelectedItem="{Binding SelectedTriggerSource}" />
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                Grid.Column="0"
                                Background="#CCE5FF"
                                BorderBrush="#B8DAFF"
                                Command="{Binding StartGrabCommand}"
                                Content="开始采集"
                                Style="{StaticResource ModernButton}" />
                            <Button
                                Grid.Column="1"
                                Background="#FFF3CD"
                                BorderBrush="#FFEEBA"
                                Command="{Binding StopGrabCommand}"
                                Content="停止采集"
                                Style="{StaticResource ModernButton}" />
                        </Grid>

                        <Button
                            Margin="5,0,5,5"
                            Command="{Binding SoftTriggerCommand}"
                            Content="发送一次软触发"
                            Style="{StaticResource ModernButton}" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="参数配置" Style="{StaticResource ModernGroupBox}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="65" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="5"
                            VerticalAlignment="Center"
                            Text="曝光(us):" />
                        <TextBox
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="5"
                            VerticalContentAlignment="Center"
                            Text="{Binding ExposureTime}" />

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="5"
                            VerticalAlignment="Center"
                            Text="增益:" />
                        <TextBox
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="5"
                            VerticalContentAlignment="Center"
                            Text="{Binding Gain}" />

                        <Grid
                            Grid.Row="2"
                            Grid.ColumnSpan="2"
                            Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                Grid.Column="0"
                                Command="{Binding GetParamCommand}"
                                Content="获取参数"
                                Style="{StaticResource ModernButton}" />
                            <Button
                                Grid.Column="1"
                                Command="{Binding SetParamCommand}"
                                Content="设置参数"
                                Style="{StaticResource ModernButton}" />
                        </Grid>
                    </Grid>
                </GroupBox>

                <GroupBox Header="图像保存" Style="{StaticResource ModernGroupBox}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Margin="5"
                                VerticalAlignment="Center"
                                Text="路径:" />
                            <TextBox
                                Grid.Column="1"
                                Margin="5"
                                VerticalContentAlignment="Center"
                                Text="{Binding SaveImagePath}" />
                        </Grid>

                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                Grid.Column="0"
                                Padding="5"
                                Command="{Binding SaveImageCommand}"
                                CommandParameter="bmp"
                                Content="存BMP"
                                Style="{StaticResource ModernButton}" />
                            <Button
                                Grid.Column="1"
                                Padding="5"
                                Command="{Binding SaveImageCommand}"
                                CommandParameter="jpg"
                                Content="存JPG"
                                Style="{StaticResource ModernButton}" />
                            <Button
                                Grid.Column="2"
                                Padding="5"
                                Command="{Binding SaveImageCommand}"
                                CommandParameter="png"
                                Content="存PNG"
                                Style="{StaticResource ModernButton}" />
                        </Grid>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
